    "motion": "12.38.0",
    "next": "^15.3.0",
    "next-sanity": "^9.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanity": "^3.80.0",
    "sanity-plugin-media": "^4.1.1"
  },
  "devDependencies": {
    "@sanity/vision": "^3.80.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "4.23.15",
    "typescript": "^5.8.0"
