# Copy the appropriate values into .env.local or the deployment environment.
# Never add real secrets to this file. See docs/contact-page.md.
# Development dataset + local dev defaults to demo; an isolated production build
# against development needs CONTACT_DELIVERY_MODE=demo explicitly.
CONTACT_DELIVERY_MODE=disabled

# Required only for live delivery. Live mode also requires VERCEL_ENV=production
# (set by Vercel) and NEXT_PUBLIC_SANITY_DATASET=production.
RESEND_API_KEY=
CONTACT_FROM=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random secret with at least 32 bytes; used for HMAC identifiers.
CONTACT_RATE_LIMIT_SECRET=
